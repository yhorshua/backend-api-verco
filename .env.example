NODE_ENV=development
PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario
DB_PASS=contraseña
DB_NAME=base_de_datos
DB_POOL_SIZE=10

# Autenticación: use una cadena aleatoria de 64 caracteres en producción
JWT_SECRET=reemplazar_por_un_secreto_seguro_de_64_caracteres
JWT_EXPIRES_IN=8h

# Orígenes separados por coma, sin barra final
CORS_ORIGINS=http://localhost:3000

# Redis es opcional; sin esta variable el catálogo funciona sin caché
REDIS_URL=

# Clientes del ecommerce (Google Identity Services)
GOOGLE_CLIENT_ID=
CUSTOMER_JWT_SECRET=reemplazar_por_otro_secreto_aleatorio_de_64_caracteres
CUSTOMER_JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=verco
CLOUDINARY_SYNC_ENABLED=false
CLOUDINARY_SYNC_INTERVAL_MINUTES=30

# Integraciones opcionales
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=

# Correos transaccionales del Libro de Reclamaciones (Resend)
RESEND_API_KEY=
EMAIL_SALES_ADDRESS=ventas@soomin.online
EMAIL_CLAIMS_TO=ventas@soomin.online
EMAIL_FROM=Soomin Store <ventas@soomin.online>
